{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Review KPIs",
      "query": "SELECT COUNT(*) AS events, COUNT_IF(review_status = 'reviewed') AS reviewed, COUNT_IF(review_status = 'reviewed' AND edge_classification_correct = false) AS misclassified, ROUND(100.0 * COUNT_IF(review_status = 'reviewed' AND edge_classification_correct = false) / NULLIF(COUNT_IF(review_status = 'reviewed'), 0), 1) AS misclassification_rate_pct FROM edge_events"
    },
    {
      "name": "by_type",
      "displayName": "Misclassification by edge event type",
      "query": "SELECT event_type AS edge_event_type, COUNT_IF(review_status = 'reviewed') AS reviewed, COUNT_IF(review_status = 'reviewed' AND edge_classification_correct = false) AS misclassified, ROUND(100.0 * COUNT_IF(review_status = 'reviewed' AND edge_classification_correct = false) / NULLIF(COUNT_IF(review_status = 'reviewed'), 0), 1) AS misclassification_rate_pct FROM edge_events GROUP BY event_type"
    },
    {
      "name": "corrections",
      "displayName": "Edge label vs reviewer label",
      "query": "SELECT event_type AS edge_said, corrected_event_type AS reviewer_said, COUNT(*) AS events FROM edge_events WHERE review_status = 'reviewed' AND edge_classification_correct = false GROUP BY ALL ORDER BY events DESC"
    },
    {
      "name": "misclassified_detail",
      "displayName": "Misclassified events (latest grade)",
      "query": "SELECT r.event_id, e.vehicle_id, r.edge_event_type AS edge_said, r.corrected_event_type AS reviewer_said, r.edge_severity, r.severity AS reviewer_severity, r.notes, r.reviewer, r.submitted_at, e.clip FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY event_id ORDER BY submitted_at DESC) AS rn FROM event_reviews) r JOIN edge_events e ON r.event_id = e.event_id WHERE r.rn = 1 AND r.edge_classification_correct = false ORDER BY r.submitted_at DESC"
    },
    {
      "name": "severity_agreement",
      "displayName": "Edge severity vs reviewer severity",
      "query": "SELECT edge_severity, reviewed_severity AS reviewer_severity, COUNT(*) AS events FROM edge_events WHERE review_status = 'reviewed' GROUP BY ALL ORDER BY events DESC"
    },
    {
      "name": "status",
      "displayName": "Review status",
      "query": "SELECT review_status, COUNT(*) AS events FROM edge_events GROUP BY review_status"
    }
  ],
